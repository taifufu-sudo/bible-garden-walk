{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bible-garden-api",
  "main": "backend/worker.js",
  "compatibility_date": "2026-11-26",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bible-garden-zone-db",
      "database_id": "PENDING_D1_CREATION"
    }
  ]
}
